# Copy to .env.local (git-ignored) and fill in.

# Where the dev proxy sends /api and /ws.
#   On the VPS itself:  http://127.0.0.1:8795   (auth-free local dashboard)
#   On your Mac:        https://dashboard.nolimlabs.uk
LOOPYARD_PROXY_TARGET=https://dashboard.nolimlabs.uk

# Mac only: your dash_sess cookie value (copy it from the browser devtools while
# logged in at dashboard.nolimlabs.uk). The proxy attaches it server-side, so the
# cookie never needs CORS and the data never leaves the VPS.
LOOPYARD_DASH_SESS=

# API base the app calls. Leave empty (same origin) for dev-via-proxy and for the
# production build. A native shell would set an absolute URL here.
VITE_API_BASE=

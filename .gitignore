# runtime venvs (the quickstart builds its own)
.loopyard-venv/
.venv/
venv/
# python caches / build
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
dist/
build/
# node
node_modules/
# built chat-ui artifacts (regenerated by the build; never source)
tracking_ui/chat-ui/tsconfig.tsbuildinfo
tracking_ui/chat-ui/*.tsbuildinfo
tracking_ui/static/chat/
# runtime data + logs + sockets (never commit loop data)
data/
!data/.gitkeep
# local config with secrets (only the .example ships)
config/projects.toml
config/secrets.toml
config/org.toml
config/*.local.toml
# os
.DS_Store
